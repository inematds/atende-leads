# atende-leads — copie para .env e preencha. Nenhum valor aqui é real.
# O jeito recomendado é ./instalar-vps.sh, que gera este arquivo com segredos aleatórios.
# Sem as variáveis de uma integração, ela fica desligada (nada sai pela rede):
#   EVOLUTION_URL vazio  → WhatsApp desligado (canal simulado)
#   TELEGRAM_TOKEN vazio → Telegram desligado (ofertas só no painel web)
# Ao ligar uma integração, troque o segredo dela: com WEBHOOK_SEGREDO/TELEGRAM_SEGREDO vazio, com menos de
# 16 caracteres ou contendo "troque", o servidor RECUSA subir em 0.0.0.0 (Docker).
# Gere um segredo com: python3 -c "import secrets; print(secrets.token_urlsafe(24))"

# ---------- WhatsApp: Evolution API (seção 15) ----------
# Vazio = desligado. Com o perfil "evolution" do compose, use a URL interna http://evolution-api:8080;
# com uma Evolution externa, a URL dela (ex.: https://evo.seudominio.com) e a API key dela.
EVOLUTION_URL=
EVOLUTION_API_KEY=troque-por-uma-chave-longa
EVOLUTION_INSTANCIA=loja
WEBHOOK_SEGREDO=troque-por-um-segredo-longo
# Só para o container da Evolution:
EVOLUTION_SERVER_URL=http://localhost:8081
EVOLUTION_DB_SENHA=troque-esta-senha

# ---------- Telegram (seção 16) ----------
TELEGRAM_API_URL=https://api.telegram.org
# Vazio = desligado. Token do bot criado no @BotFather.
TELEGRAM_TOKEN=
TELEGRAM_GRUPO_ID=-1001234567890
TELEGRAM_SEGREDO=troque-por-outro-segredo

# ---------- Cérebro opcional (seção 14) ----------
# Só para cerebro.tipo = "openai" (endpoint compatível com /v1/chat/completions definido no negocio.json).
CEREBRO_API_KEY=

# ---------- Nota por áudio (seção 9) ----------
# Comando LOCAL que recebe o caminho do áudio e imprime o texto. Ex.: whisper-cli -m /modelos/ggml-small.bin -nt -f
WHISPER_CMD=

# ---------- Proxy reverso confiável (seção 3) ----------
# De quais endereços aceitar o X-Forwarded-For (lista de CIDRs). Padrão: loopback + redes privadas
# (o Caddy/Nginx no host chega ao container pelo gateway da bridge do Docker, 172.x.0.1).
# Vazio = nunca confiar no X-Forwarded-For.
# ATENDE_PROXY_CONFIAVEL=127.0.0.1/32,::1/128,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# Conexões simultâneas atendidas (acima disso, 503). Padrão 64.
# ATENDE_MAX_CONEXOES=64

# ---------- Segredos de exemplo (seção 1) ----------
# Com o token/códigos do exemplos/negocio.json, ou com WEBHOOK_SEGREDO/TELEGRAM_SEGREDO fracos numa
# integração ligada, o servidor só sobe em 127.0.0.1. Em 0.0.0.0 (Docker) ele recusa, a menos que esta
# variável seja 1 — use SÓ para teste/demonstração, nunca em produção.
# ATENDE_PERMITIR_EXEMPLO=1

TZ=America/Sao_Paulo
